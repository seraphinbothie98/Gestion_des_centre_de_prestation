# ==============================================================================
# CENTRE MANAGEMENT SYSTEM (CMS) - ENV CONFIGURATION
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
VITE_APP_TITLE="CMS - Multi-Services & Formations"
VITE_API_URL="http://localhost:3000/api"

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/cms_db?schema=public"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Authentication & Security
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars"
SESSION_EXPIRY="7d"

# Storage Configuration (Supabase Storage / AWS S3 / Local)
STORAGE_PROVIDER="supabase" # supabase | s3 | local
STORAGE_BUCKET="cms-documents"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="eu-west-1"

# Payment Providers Configuration
PAYMENT_DEFAULT_CURRENCY="GNF" # GNF, XOF, EUR, USD
PAYMENT_ORANGE_MONEY_API_KEY=""
PAYMENT_MTN_MOMO_API_KEY=""
PAYMENT_STRIPE_SECRET_KEY=""

# Notification Providers Configuration
EMAIL_PROVIDER="smtp" # smtp | resend | sendgrid
EMAIL_SMTP_HOST="smtp.mailtrap.io"
EMAIL_SMTP_PORT=2525
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
EMAIL_FROM="notifications@cms-centre.com"

SMS_PROVIDER="twilio" # twilio | infobip | custom
SMS_API_KEY=""
SMS_SENDER_ID="CMS-CENTRE"

WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
